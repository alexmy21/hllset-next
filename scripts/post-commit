#!/bin/sh
# Git post-commit hook — ingest changed files into HLLSet lattice.
#
# Install: ln -sf ../../scripts/post-commit .git/hooks/post-commit
# Or run manually after a commit: ./scripts/post-commit
#
# Idempotent — safe to re-run on the same commit.

# Resolve the real script location (follows symlinks)
SCRIPT_PATH="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

COMMIT_HASH=$(git rev-parse HEAD 2>/dev/null || echo "")

if [ -z "$COMMIT_HASH" ]; then
    echo "[hllset-ingest] Not in a git repository — skipping."
    exit 0
fi

echo "[hllset-ingest] Processing commit ${COMMIT_HASH:-HEAD} ..."
python3 "$PROJECT_ROOT/scripts/ingest.py" commit "$COMMIT_HASH"
echo "[hllset-ingest] Done."
